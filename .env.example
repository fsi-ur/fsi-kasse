# Database
DB_ROOT_PASSWORD=change_me_root
DB_HOST=kasse-db
DB_PORT=3306
DB_USER=fsi
DB_PASSWORD=fsi_password
DB_NAME=fsi_kasse
DB_CONN_LIMIT=5

# Accounting mode
# In connected mode use the restricted user created in the accounting database
# by the buchhaltung's "npm run setup:connection-db-user" as ACCOUNTING_DB_USER.
ACCOUNTING_MODE=standalone   # standalone/connected
ACCOUNTING_DB_HOST=buchhaltung-db
ACCOUNTING_DB_PORT=3307
ACCOUNTING_DB_USER=fsi_buchhaltung_connect
ACCOUNTING_DB_PASSWORD=change_me_connection
ACCOUNTING_DB_NAME=fsi_buchhaltung
ACCOUNTING_DB_CONN_LIMIT=5

# Restricted DB user for the accounting app, created in THIS database by
# "npm run setup:connection-db-user" (read-only access to the sales tables).
# Point the buchhaltung's CASH_REGISTER_DB_USER/CASH_REGISTER_DB_PASSWORD at
# these credentials.
CONNECTION_DB_USER=fsi_kasse_connect
CONNECTION_DB_PASSWORD=change_me_connection

# Connected mode: also accept the accounting app's session cookie so that
# users logged into the accounting application can manage the cash register.
ACCOUNTING_SESSION_COOKIE_NAME=fsi_session_db
# Connected mode: comma separated list of accounting app origins that may call
# the cash register API cross-origin (leave empty when both apps share a domain).
ACCOUNTING_APP_ORIGINS=

# Session / auth
SESSION_COOKIE_NAME=fsi_session_ks
SESSION_SECRET=replace_me_with_random
SESSION_INACTIVITY_MINUTES=30
SESSION_MAX_AGE_MINUTES=1440

# Admin bootstrap
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin

# Nuxt runtime
HOST=0.0.0.0
PORT=3001
APP_BASE_URL=/
