# Database
DB_ROOT_PASSWORD=change_me_root
DB_HOST=kasse-db
DB_PORT=3306
DB_USER=fsi
DB_PASSWORD=fsi_password
DB_NAME=fsi_kasse
DB_CONN_LIMIT=5

# Accounting mode
# In connected mode use the restricted user created in the accounting database
# by the buchhaltung's "npm run setup:connection-db-user" as ACCOUNTING_DB_USER.
ACCOUNTING_MODE=standalone   # standalone/connected
ACCOUNTING_DB_HOST=buchhaltung-db
ACCOUNTING_DB_PORT=3307
ACCOUNTING_DB_USER=fsi_buchhaltung_connect
ACCOUNTING_DB_PASSWORD=change_me_connection
ACCOUNTING_DB_NAME=fsi_buchhaltung
ACCOUNTING_DB_CONN_LIMIT=5

# Shared secret for the accounting app's integration API (its per-event cash
# register tab). Set the same value as CASH_REGISTER_API_KEY in the buchhaltung.
# At least 32 characters, e.g. `openssl rand -hex 32`; empty disables the API.
INTEGRATION_API_KEY=

# Connected mode: also accept the accounting app's session cookie so that
# users logged into the accounting application can manage the cash register.
ACCOUNTING_SESSION_COOKIE_NAME=fsi_session_db
# Connected mode: comma separated list of accounting app origins that may call
# the cash register API cross-origin (leave empty when both apps share a domain).
ACCOUNTING_APP_ORIGINS=

# Session / auth
SESSION_COOKIE_NAME=fsi_session_ks
SESSION_SECRET=replace_me_with_random
SESSION_INACTIVITY_MINUTES=30
SESSION_MAX_AGE_MINUTES=1440

# Admin bootstrap
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin

# Nuxt runtime
HOST=0.0.0.0
PORT=3001
APP_BASE_URL=/

# SumUp card terminals (leave SUMUP_API_KEY empty to disable card payments entirely).
# Server-only: never exposed to the client or written to the database.
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
# Affiliate key from the SumUp dashboard — reader checkouts require it.
SUMUP_AFFILIATE_APP_ID=
SUMUP_AFFILIATE_KEY=
# Public HTTPS origin incl. the APP_BASE_URL path that SumUp can POST webhooks to,
# e.g. https://kasse.example.org/kasse
SUMUP_WEBHOOK_BASE_URL=
# real | mock — mock simulates a terminal for development (see server/utils/sumupMock.ts)
SUMUP_MODE=real
